# Example environment variables for connector_backend_api

# FastAPI metadata
APP_NAME=Connector Backend API
APP_DESCRIPTION=Backend service managing connectors and authentication
APP_VERSION=0.1.0
ENVIRONMENT=development

# CORS (comma-separated list or * for MVP)
# Example: http://localhost:3000,https://your-frontend.app
CORS_ALLOW_ORIGINS=*

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=connector_platform

# OAuth State / JWT (MVP uses same secret/algorithm for state and simple auth parsing)
JWT_ALGORITHM=HS256
JWT_STATE_SECRET=CHANGE_ME
JWT_STATE_TTL_SECONDS=600

# API Key hashing
API_KEY_HASH_SALT=CHANGE_ME_SALT
API_KEY_HASH_ALGORITHM=sha256

# Encryption (AES-256-GCM) key for secure token storage (base64-encoded 32 bytes)
# Example to generate: python - <<<'import os,base64; print(base64.b64encode(os.urandom(32)).decode())'
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1

# Multi-tenant header name
TENANT_HEADER_NAME=X-Tenant-ID
DEFAULT_TENANT_ID=

# Site URL for OAuth callbacks (used when frontend doesn't pass x-redirect-uri header)
SITE_URL=http://localhost:3000
