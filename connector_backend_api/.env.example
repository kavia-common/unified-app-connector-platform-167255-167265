# Example environment for Connector Backend API

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=connector_platform

# App
ENVIRONMENT=development
APP_VERSION=0.1.0

# JWT (used for state signing in OAuth MVP)
JWT_ALGORITHM=HS256
JWT_STATE_SECRET=CHANGE_ME_STATE_SECRET
JWT_STATE_TTL_SECONDS=600

# API Key hashing
API_KEY_HASH_SALT=CHANGE_ME_SALT
API_KEY_HASH_ALGORITHM=sha256

# CORS
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
TENANT_HEADER_NAME=X-Tenant-ID

# SITE URL for redirects
SITE_URL=http://localhost:3000

# Encryption for stored credentials (MANDATORY in prod)
# Base64-encoded 32-byte key for AES-256 (e.g., `openssl rand -base64 32`)
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1
