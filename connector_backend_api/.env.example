# Application
APP_NAME=Connector Backend API
APP_DESCRIPTION=Backend service for unified modular connector platform
APP_VERSION=0.1.0
ENVIRONMENT=development

# CORS (comma-separated)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=connector_platform

# Security - JWT for OAuth state (CHANGE IN PRODUCTION)
JWT_ALGORITHM=HS256
JWT_STATE_SECRET=CHANGE_ME
JWT_STATE_TTL_SECONDS=600

# API Key hashing (CHANGE IN PRODUCTION)
API_KEY_HASH_SALT=CHANGE_ME_SALT
API_KEY_HASH_ALGORITHM=sha256

# Multi-tenancy
TENANT_HEADER_NAME=X-Tenant-ID
# DEFAULT_TENANT_ID can be set for local development only
# DEFAULT_TENANT_ID=dev-tenant

# Public site URL for redirects (used by OAuth flows)
# SITE_URL=https://your-frontend.example.com
