# Application
APP_NAME=Connector Backend API
APP_DESCRIPTION=Backend service managing connectors and authentication.
APP_VERSION=0.1.0
ENVIRONMENT=development

# CORS (tighten in production)
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type","X-Tenant-ID","X-Request-ID"]

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=connector_platform

# JWT (OAuth state and MVP app token)
JWT_ALGORITHM=HS256
JWT_STATE_SECRET=change_me_to_a_strong_secret
JWT_STATE_TTL_SECONDS=600

# API key hashing
API_KEY_HASH_SALT=change_me_salt
API_KEY_HASH_ALGORITHM=sha256

# Encryption (AES-GCM) - base64 of 32 random bytes for AES-256
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1

# Multi-tenant
TENANT_HEADER_NAME=X-Tenant-ID
DEFAULT_TENANT_ID=

# Public site URL (https recommended in production)
SITE_URL=http://localhost:3000
